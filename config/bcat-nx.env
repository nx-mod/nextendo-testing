# BCAT delivery cache (bcat-*.cdn.nintendo.net, TLS passthrough from sni-router).
PORTS=8470
NEXTENDO_HOST=${HOST}
BCAT_PORT=8470
# Its own certificate: BCAT checks the name, and the shared cert.pem does not cover *.cdn.nintendo.net
# (the console ended every handshake, so News "Find channels" failed to load).
CERT_FILE=${CERTS}\bcat_cert.pem
KEY_FILE=${CERTS}\key.pem
BCAT_CONTENT=${STATE}\content
BCAT_NEWS_DIR=${ROOT}\stack\news
# News container passphrase and salts (published with the testing stack, like its other keys).
BCAT_NEWS_SECRETS=${SECRETS}\bcat_news_secrets.json
BCAT_KEY_FILE=${SECRETS}\bcat_signing_key.pem
