# :443 by SNI to every service above (TLS passthrough). Local only: unknown hosts are dropped.
PORTS=443
SNI_LISTEN=:443
SNI_PROXY_PROTOCOL=1
BACKEND_DEFAULT=drop
BACKEND_ACCOUNT=127.0.0.1:8455
BACKEND_BAAS=127.0.0.1:8453
BACKEND_DAUTH=127.0.0.1:8446
BACKEND_SCSI=127.0.0.1:8452
BACKEND_BCAT=127.0.0.1:8470
BACKEND_MK8=127.0.0.1:8443
BACKEND_SSBU=127.0.0.1:8445
BACKEND_ACNH=127.0.0.1:8447
BACKEND_SMM2=127.0.0.1:8449
BACKEND_D3=127.0.0.1:8460
BACKEND_BL1=127.0.0.1:8456
BACKEND_TL2=127.0.0.1:8458
BACKEND_AW=127.0.0.1:8459
