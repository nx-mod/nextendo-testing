# NPLN (gRPC over HTTP/2). GameSync (:7575) is a second process: splatoon-3-gamesync.
PORTS=7443
NPLN_LISTEN=:7443
# Its default :8080 is the account service's port.
NPLN_H2C_LISTEN=:7446
NPLN_CAPTURES_DIR=${STATE}\captures
# What matchmaking tells the console: its game session on GameSync, STUN/TURN on Peace Walker's servers.
NPLN_RELAY_HOST=${HOST}
NPLN_RELAY_PORT=7575
NPLN_STUN_HOST=${HOST}
NPLN_STUN_PORT=3478
NPLN_TURN_HOST=${HOST}
NPLN_TURN_PORT=3479
NPLN_LATENCY_HOST=${HOST}
