# Crash Team Racing Nitro-Fueled (and Diablo III), upstream's merged Demonware server. Same ports and hosts as
# diablo-3-nx: run one or the other (swap them in stack.cfg GAMES). Needs CTR_AUTH_SIGNING_KEY, an RSA-2048
# key whose public half is in the CTR client mod (neither is shipped upstream), and openssl on the PATH.
PORTS=8460,3074
AUTH_PORT=8460
DASH_PORT=8093
CWD=${ROOT}\games\crash-team-racing
DASH_TOKEN=local
NEXTENDO_SECRET_FILE=${SECRETS}\nextendo_secret.key
D3_DUMPS=${STATE}\dumps
CTR_AUTH_SIGNING_KEY=
