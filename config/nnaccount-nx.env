# The Nintendo Account side (accounts.nintendo.com /connect, api.accounts users/me). tls-front sends it here.
PORTS=8480
NNACCOUNT_LISTEN=127.0.0.1:8480
NNACCOUNT_DATA=${STATE}
NNACCOUNT_ACCOUNT_URL=http://127.0.0.1:8080
# A Nintendo Account this stack has never seen (a console linked on production Nextendo) gets an account of
# its own instead of "sign in again". LAN only, like the account service's NEXTENDO_LOCAL_OPEN.
NNACCOUNT_LOCAL_OPEN=1
