# --- 2) NAT-check #2: MUST be a different IP from nncs1, or Pia dedups the
#        probe, NAT never completes, and MK8/S2 fail with 2618-201 / test-103.
#        ${HOST2} is a secondary address on this PC's Wi-Fi adapter;
#        the nncs service listens on 0.0.0.0 so it answers on both.
${HOST2}  nncs2-*.n.n.srv.nintendo.net

# --- 3) ANTI-BAN: telemetry -> the stack's telemetry sink (telemetry-nx), never Nintendo ---
# Not 0.0.0.0: a null route may be what fails the console's Test Connection (2160-6000).
${HOST}    receive-%.dg.srv.nintendo.net
${HOST}    receive-%.er.srv.nintendo.net

# --- 4) d4c (system update) -> NOT redirected ---
# Do NOT null-route: nim stores a persistent flag.

# --- 5) conntest (browser connectivity check) -> local stack ---
${HOST} conntest.nintendowifi.net
${HOST} ctest.cdn.nintendo.net

