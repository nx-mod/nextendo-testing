# BaaS: application tokens, device login (the console's user), users, snapshot.
PORTS=8453
BAAS_PORT=:8453
BAAS_SIGNING_KEY=${CERTS}\baas_signing_key.pem
NEXTENDO_SECRET_FILE=${SECRETS}\nextendo_secret.key
BAAS_USERS_FILE=${STATE}\baas_users.json
BAAS_IMAGES_DIR=${STATE}\images
# The "global IP" the connection test reports to the console (behind sni-router it would be 127.0.0.1).
BAAS_GLOBAL_IP=${HOST}
CERT_FILE=${CERTS}\cert.pem
KEY_FILE=${CERTS}\key.pem
# penne push: 1 serves login tickets and the frontline stream (the console holds a session: handshake,
# subscriptions, keepalive); 0 turns it off. Sessions are recorded to BAAS_FRONTLINE_DIR.
BAAS_PENNE_FRONTLINE=1
BAAS_FRONTLINE_DIR=${STATE}\frontline
