# NPLN (gRPC) server; its default :443 would take sni-router's port.
PORTS=8509
NPLN_LISTEN=0.0.0.0:8509
NPLN_CA_CERT_FILE=${CERTS}\local_ca.pem
NPLN_CA_KEY_FILE=${CERTS}\local_ca.key
# NPLN generates its own TLS cert and key: keep them out of the shared stack\certs.
CERT_FILE=${STATE}\cert.pem
KEY_FILE=${STATE}\key.pem
# Its STUN/TURN on the LAN (defaults are 127.0.0.1, unreachable from a console); Splatoon 3 uses them too.
NPLN_STUN_LISTEN=0.0.0.0:3478
NPLN_TURN_LISTEN=0.0.0.0:3479
NPLN_TURN_RELAY_IP=${HOST}
NPLN_STUN_HOST=${HOST}
NPLN_TURN_HOST=${HOST}
NPLN_GAMESESSION_HOST=${HOST}
NPLN_LATENCY_HOST=${HOST}
