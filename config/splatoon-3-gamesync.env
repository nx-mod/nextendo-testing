# Splatoon 3 GameSync: the same binary in GameSync-only mode, the session transport consoles reach directly
# on ${HOST}:7575 (upstream runs it as a second process too).
PORTS=7575
EXE=splatoon-3
NPLN_GAMESYNC_ONLY=1
NPLN_GAMESYNC_LISTEN=:7575
NPLN_DASH_LISTEN=:8090
NPLN_CAPTURES_DIR=${STATE}\captures
