# Crash Team Racing Nitro-Fueled (and Diablo III), upstream's merged Demonware server. Same ports and hosts as
# diablo-3-nx: run one or the other (swap them in stack.cfg GAMES). CTR replies are signed with this stack's
# RSA-2048 key (openssl on the PATH); the CTR client mod must carry stack\secrets\ctr_auth_signing_pub.pem.
PORTS=8460,3074
AUTH_PORT=8460
DASH_PORT=8093
CWD=${ROOT}\games\crash-team-racing
DASH_TOKEN=local
NEXTENDO_SECRET_FILE=${SECRETS}\nextendo_secret.key
D3_DUMPS=${STATE}\dumps
CTR_AUTH_SIGNING_KEY=${SECRETS}\ctr_auth_signing_key.pem
